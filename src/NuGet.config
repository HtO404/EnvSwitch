<?xml version="1.0" encoding="utf-8"?>
<!-- 只保留 nuget.org 一个源，且只有编译期需要（net48 参考程序集）：
     首次 restore 会下载 Microsoft.NETFramework.ReferenceAssemblies.net48（约 1MB）并缓存到 ~/.nuget，
     之后可离线编译；运行期产物不依赖任何 NuGet 包。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
