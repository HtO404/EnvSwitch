<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 白天：纯白底 + 橙主色。底色/发丝线/告警红取自DemoConsole真实界面截图采样值。
         色值经 tools\对比度体检.py 实测达标（正文 ≥4.5、弱化 ≥3.0）。 -->
    <SolidColorBrush x:Key="Bg" Color="#FEFEFE"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F6F7F7"/>
    <SolidColorBrush x:Key="Line" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="LineSoft" Color="#F0F1F1"/>
    <SolidColorBrush x:Key="Ink" Color="#1A1D1C"/>
    <SolidColorBrush x:Key="Ink2" Color="#6B7370"/>
    <SolidColorBrush x:Key="Ink3" Color="#8C9390"/>

    <SolidColorBrush x:Key="Brand" Color="#B34A0C"/>
    <SolidColorBrush x:Key="BrandHover" Color="#9C400A"/>
    <SolidColorBrush x:Key="BrandPress" Color="#833505"/>
    <SolidColorBrush x:Key="BrandSoft" Color="#FFF3E9"/>
    <SolidColorBrush x:Key="OnBrand" Color="#FFFFFF"/>

    <!-- 告警三件套：Danger=图形/小方块（≥3:1）；DangerFill+OnDanger=实心徽章；DangerInk=警示文字 -->
    <SolidColorBrush x:Key="Danger" Color="#F95151"/>
    <SolidColorBrush x:Key="DangerFill" Color="#C0392B"/>
    <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerInk" Color="#B3261E"/>
    <SolidColorBrush x:Key="Ok" Color="#1F7A5C"/>

    <!-- 品牌标记固定双色（与 图标.ico 一致，不随主题变） -->
    <SolidColorBrush x:Key="MarkDay" Color="#C2570F"/>
    <SolidColorBrush x:Key="MarkNight" Color="#3ED0AE"/>

    <FontFamily x:Key="FontDisplay">Noto Sans SC, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontBody">Noto Sans SC, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>
</ResourceDictionary>
